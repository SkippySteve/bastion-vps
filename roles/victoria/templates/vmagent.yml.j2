global:
  scrape_interval: 30s
  scrape_timeout: 10s

scrape_configs:
  - job_name: node
    static_configs:
      - targets: ["127.0.0.1:9100"]
  - job_name: forgejo
    static_configs:
      - targets: ["127.0.0.1:{{ forgejo_http_port }}"]
  - job_name: authentik
    static_configs:
      - targets: ["127.0.0.1:{{ authentik_metrics_port }}"]
{% if waf_provider | default('crowdsec') == 'crowdsec' %}
  - job_name: crowdsec
    static_configs:
      - targets: ["127.0.0.1:{{ crowdsec_metrics_port }}"]
{% endif %}
