apiVersion: 1
datasources:
  - name: VictoriaMetrics
    type: prometheus
    access: proxy
    url: http://victoriametrics:8428
    isDefault: true
  - name: VictoriaLogs
    type: victoriametrics-logs-datasource
    access: proxy
    url: http://victorialogs:9428
  - name: Traces
    type: tempo
    access: proxy
    url: {{ ('http://tempo:3200' if victoria_trace_backend == 'tempo' else 'http://victoriatraces:10428/select/tempo') | to_json }}
