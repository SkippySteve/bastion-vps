version 2

{% set silk_sensors = sensor_interfaces | unique | map('regex_replace', '[^A-Za-z0-9.-]', '-') | list %}
{% for interface in sensor_interfaces | unique %}
sensor {{ loop.index0 }} {{ silk_sensors[loop.index0] }} "Host interface {{ interface }}"
{% endfor %}

class all
  sensors {{ silk_sensors | join(' ') }}
end class

class all
  type 0 in in
  type 1 out out
  type 2 inweb iw
  type 3 outweb ow
  type 4 innull innull
  type 5 outnull outnull
  type 6 int2int int2int
  type 7 ext2ext ext2ext
  type 8 inicmp inicmp
  type 9 outicmp outicmp
  type 10 other other
  default-types in inweb inicmp
end class

default-class all
path-format "%T/%Y/%m/%d/%x"
packing-logic "packlogic-twoway.so"
