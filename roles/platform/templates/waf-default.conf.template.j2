{% endif %}

server {
    listen 127.0.0.1:${WAF_STATUS_PORT};
    server_name localhost;
    server_tokens off;

    location = /nginx_status {
        stub_status;
        modsecurity off;
        access_log off;
        allow 127.0.0.1;
        deny all;
    }
}
