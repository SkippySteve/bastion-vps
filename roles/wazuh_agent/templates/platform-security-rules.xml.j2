<group name="platform_security,">
  <rule id="100400" level="5">
    <program_name>^kernel$</program_name>
    <match>nft-input-drop</match>
    <description>Host firewall dropped an inbound packet.</description>
    <group>platform_firewall,</group>
  </rule>

  <rule id="100401" level="10" frequency="10" timeframe="60">
    <if_matched_sid>100400</if_matched_sid>
    <description>Repeated inbound firewall drops indicate a possible scan.</description>
    <group>platform_firewall,scan,</group>
  </rule>

  <rule id="100402" level="5">
    <program_name>^(sshd|sudo|su|useradd|usermod|userdel|groupadd|groupmod|groupdel|passwd|polkitd)$</program_name>
    <description>Host authentication or account-management event.</description>
    <group>platform_auth,</group>
  </rule>

  <rule id="100403" level="9">
    <if_sid>100402</if_sid>
    <match type="pcre2">(?i)(failed|failure|invalid user|authentication error|not in sudoers)</match>
    <description>Host authentication or privilege failure.</description>
    <group>platform_auth,authentication_failed,</group>
  </rule>

  <rule id="100404" level="3">
    <program_name>^(authentik-server|authentik-worker|forgejo)$</program_name>
    <description>Selected identity or source-control security event.</description>
    <group>platform_container,platform_auth,</group>
  </rule>

  <rule id="100405" level="9">
    <if_sid>100404</if_sid>
    <match type="pcre2">(?i)(failed|failure|denied|invalid|unauthorized|forbidden|locked)</match>
    <description>Identity or source-control authentication failure.</description>
    <group>platform_container,platform_auth,authentication_failed,</group>
  </rule>

  <rule id="100406" level="10">
    <program_name>^(modsecurity-crs|nginx)$</program_name>
    <match type="pcre2">(?i)(ModSecurity|Access denied|Warning)</match>
    <description>ModSecurity CRS detected or blocked a request.</description>
    <group>platform_waf,attack,</group>
  </rule>

  <rule id="100407" level="6">
    <program_name>^traefik$</program_name>
    <match type="pcre2">("DownstreamStatus":(401|403|429)|TLS handshake error|invalid request)</match>
    <description>Traefik rejected or could not negotiate a request.</description>
    <group>platform_waf,platform_container,</group>
  </rule>

  <rule id="100408" level="5">
    <field name="security.source">^packages$</field>
    <description>Host package state changed.</description>
    <group>platform_package_change,</group>
  </rule>

  <rule id="100409" level="7">
    <program_name>^(sshd|auditd|fail2ban-server)$</program_name>
    <match type="pcre2">(?i)(failed|failure|fatal|disabled|denied)</match>
    <description>A host security control reported a failure.</description>
    <group>platform_control_health,</group>
  </rule>

  <rule id="100410" level="10">
    <decoded_as>json</decoded_as>
    <field name="sensor.type">^suricata$</field>
    <field name="event_type">^alert$</field>
    <description>Suricata network IDS alert: $(alert.signature).</description>
    <group>platform_network_ids,suricata,</group>
  </rule>

  <rule id="100411" level="7">
    <decoded_as>json</decoded_as>
    <field name="sensor.type">^suricata$</field>
    <field name="event_type">^anomaly$</field>
    <description>Suricata network anomaly.</description>
    <group>platform_network_ids,suricata,</group>
  </rule>

  <rule id="100412" level="7">
    <decoded_as>json</decoded_as>
    <field name="sensor.type">^zeek$</field>
    <field name="zeek.log">^notice.log$</field>
    <description>Zeek notice: $(note).</description>
    <group>platform_network_ids,zeek,</group>
  </rule>

  <rule id="100413" level="12">
    <decoded_as>json</decoded_as>
    <field name="sensor.type">^zeek$</field>
    <field name="zeek.log">^intel.log$</field>
    <description>Zeek intelligence match.</description>
    <group>platform_network_ids,zeek,threat_intel,</group>
  </rule>

  <rule id="100414" level="10">
    <decoded_as>json</decoded_as>
    <field name="sensor.type">^zeek$</field>
    <field name="zeek.log">^signatures.log$</field>
    <description>Zeek signature match.</description>
    <group>platform_network_ids,zeek,</group>
  </rule>

  <rule id="100415" level="5">
    <decoded_as>json</decoded_as>
    <field name="sensor.type">^zeek$</field>
    <field name="zeek.log">^(weird|files|ssl|ssh)[.]log$</field>
    <description>Selected Zeek security metadata.</description>
    <group>platform_network_ids,zeek,</group>
  </rule>
</group>
