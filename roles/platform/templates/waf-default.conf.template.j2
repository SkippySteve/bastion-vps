map $host $platform_upstream {
    default "";
    {{ auth_fqdn }} http://127.0.0.1:{{ authentik_http_port }};
    {{ git_fqdn }} http://127.0.0.1:{{ forgejo_http_port }};
    {{ observe_fqdn }} http://127.0.0.1:{{ signoz_ui_port }};
    {{ security_fqdn }} https://127.0.0.1:{{ wazuh_dashboard_port }};
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 127.0.0.1:${PORT};
    server_name {{ auth_fqdn }} {{ git_fqdn }} {{ observe_fqdn }} {{ security_fqdn }};
    server_tokens off;

    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    include /etc/nginx/fail2ban-deny.conf;

    location = /healthz {
        modsecurity off;
        access_log off;
        return 200 "ok\n";
    }

    # Hidden .git directory only. ~* \.git also matches /owner/repo.git/info/refs.
    location ~ /\.git(?:/|$) {
        deny all;
    }

    # Forward-auth callbacks arrive on the app Host. Do not send them to SigNoz
    # or Wazuh if Traefik still hands this path to the WAF.
    location /outpost.goauthentik.io/ {
        proxy_pass http://127.0.0.1:{{ authentik_http_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        if ($platform_upstream = "") { return 421; }
        proxy_pass $platform_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_ssl_server_name on;
        proxy_ssl_name wazuh.dashboard;
        proxy_ssl_trusted_certificate /etc/nginx/wazuh-root-ca.pem;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 2;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 512m;
    }
}
