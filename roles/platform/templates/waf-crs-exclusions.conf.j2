# SigNoz's logs explorer stores its structured query as a deliberately
# double-encoded URL argument.  The decoded JSON contains SQL-like operators
# (AND, count(), quoted values), which can trip CRS SQL-injection signatures.
# Keep CRS enabled everywhere else and remove only SQLi inspection from these
# three SigNoz-owned arguments on the exact explorer endpoint.
SecRule REQUEST_HEADERS:Host "@streq {{ observe_fqdn }}" \
 "id:10011,\
  phase:1,\
  pass,\
  nolog,\
  t:none,\
  chain"
SecRule REQUEST_URI "@streq /logs/logs-explorer" \
 "t:none,\
  ctl:ruleRemoveTargetById=942100;ARGS:compositeQuery,\
  ctl:ruleRemoveTargetById=942110;ARGS:compositeQuery,\
  ctl:ruleRemoveTargetById=942120;ARGS:compositeQuery,\
