---
{# Ansible trim_blocks deletes the newline after {% endif %}. Keep tls as a
   variable so that tag never sits at the end of a YAML line. #}
{% set traefik_router_tls = {"certResolver": "letsencrypt"} if (traefik_acme_enabled | default(true) | bool) else {} %}
{% set traefik_router_observability = {"accessLogs": true, "metrics": true, "tracing": true, "traceVerbosity": "detailed"} %}
{% set traefik_admin_chain = "admin-chain" if (protect_admin_apps_with_authentik | bool) else "bootstrap-admin-chain" %}
{% set traefik_outpost_hosts = [observe_fqdn, security_fqdn, traefik_fqdn] %}
http:
  routers:
    authentik:
      entryPoints: [websecure]
      rule: "Host(`{{ auth_fqdn }}`)"
      service: waf
      middlewares: [public-chain]
      tls: {{ traefik_router_tls | to_json }}
      observability: {{ traefik_router_observability | to_json }}
    forgejo:
      entryPoints: [websecure]
      rule: "Host(`{{ git_fqdn }}`)"
      service: waf
      middlewares: [public-chain]
      tls: {{ traefik_router_tls | to_json }}
      observability: {{ traefik_router_observability | to_json }}
{% if enable_scrapecast | default(true) | bool %}
    scrapecast:
      entryPoints: [websecure]
      rule: "Host(`{{ app_fqdn }}`)"
      service: waf
      middlewares: [public-chain]
      tls: {{ traefik_router_tls | to_json }}
      observability: {{ traefik_router_observability | to_json }}
    scrapecast-www:
      entryPoints: [websecure]
      rule: "Host(`{{ app_www_fqdn }}`)"
      service: waf
      middlewares: [www-to-apex, public-chain]
      tls: {{ traefik_router_tls | to_json }}
      observability: {{ traefik_router_observability | to_json }}
{% endif %}
    signoz:
      entryPoints: [websecure]
      rule: "Host(`{{ observe_fqdn }}`)"
      priority: 10
      service: waf
      middlewares: [{{ traefik_admin_chain }}]
      tls: {{ traefik_router_tls | to_json }}
      observability: {{ traefik_router_observability | to_json }}
    wazuh:
      entryPoints: [websecure]
      rule: "Host(`{{ security_fqdn }}`)"
      priority: 10
      service: waf
      middlewares: [{{ traefik_admin_chain }}]
      tls: {{ traefik_router_tls | to_json }}
      observability: {{ traefik_router_observability | to_json }}
{% if protect_admin_apps_with_authentik | bool %}
    traefik-dashboard:
      entryPoints: [websecure]
      rule: "Host(`{{ traefik_fqdn }}`) && (PathPrefix(`/api`) || PathPrefix(`/dashboard`))"
      priority: 10
      service: api@internal
      middlewares: [admin-chain]
      tls: {{ traefik_router_tls | to_json }}
      observability: {{ traefik_router_observability | to_json }}
{% for outpost_host in traefik_outpost_hosts %}
    authentik-outpost-{{ outpost_host | regex_replace('[^a-z0-9]+', '-') }}:
      entryPoints: [websecure]
      rule: "Host(`{{ outpost_host }}`) && PathPrefix(`/outpost.goauthentik.io/`)"
      priority: 15
      service: authentik-outpost
      tls: {{ traefik_router_tls | to_json }}
      observability: {{ traefik_router_observability | to_json }}
{% endfor %}
{% endif %}

  services:
    waf:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://127.0.0.1:{{ waf_http_port }}"
    authentik-outpost:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://127.0.0.1:{{ authentik_http_port }}"

  middlewares:
{% if enable_scrapecast | default(true) | bool %}
    www-to-apex:
      redirectRegex:
        regex: '^https://{{ app_www_fqdn | regex_escape }}(.*)'
        replacement: 'https://{{ app_fqdn }}${1}'
        permanent: true
{% endif %}
    public-chain:
      chain:
        middlewares: [security-headers, compress, rate-limit]
    admin-chain:
      chain:
        middlewares: [authentik-forward, security-headers, compress, rate-limit]
    bootstrap-admin-chain:
      chain:
        middlewares: [bootstrap-auth, security-headers, compress, rate-limit]
    bootstrap-auth:
      basicAuth:
        users:
          - "{{ bootstrap_admin_htpasswd | replace('$', '$$') }}"
        removeHeader: true
    authentik-forward:
      forwardAuth:
        address: "http://127.0.0.1:{{ authentik_http_port }}/outpost.goauthentik.io/auth/traefik"
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-entitlements
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid
    security-headers:
      headers:
        browserXssFilter: true
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: strict-origin-when-cross-origin
        permissionsPolicy: "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        stsSeconds: 63072000
        stsIncludeSubdomains: true
        stsPreload: true
    compress:
      compress: {}
    rate-limit:
      rateLimit:
        average: 100
        burst: 200
        period: 1s
        sourceCriterion:
          ipStrategy:
            depth: 0

tls:
  options:
    default:
      minVersion: VersionTLS12
      sniStrict: true
      cipherSuites:
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
{% if not (traefik_acme_enabled | default(true) | bool) %}
  certificates:
    - certFile: /etc/traefik/tls/lab-server.pem
      keyFile: /etc/traefik/tls/lab-server.key
  stores:
    default:
      defaultCertificate:
        certFile: /etc/traefik/tls/lab-server.pem
        keyFile: /etc/traefik/tls/lab-server.key
{% endif %}
