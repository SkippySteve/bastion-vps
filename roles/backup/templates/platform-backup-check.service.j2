[Unit]
Description=Weekly restic check of the platform backup repository
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
Environment=HOME=/root
ExecStart=/usr/local/bin/resticprofile -c /etc/resticprofile/profiles.yaml check
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
