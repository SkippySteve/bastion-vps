require 'open3'
require 'base64'
require 'digest/sha1'
require 'fileutils'
require 'stringio'
require 'zlib'

$vm_cpus = 4
$vm_memory = 8*1024 # MB
$vm_disk = 64 # GB

def gzip_base64(data)
  o = StringIO.new()
  w = Zlib::GzipWriter.new(o)
  w.write(data)
  w.close()
  Base64.strict_encode64(o.string)
end

def vagrant_run_ansible?
  ENV['VAGRANT_ANSIBLE'].to_s.match?(/\A(1|true|yes)\z/i)
end

def vagrant_bridged?
  ENV['VAGRANT_BRIDGED'].to_s.match?(/\A(1|true|yes)\z/i)
end

def vagrant_firewall_lockdown?
  ENV['FIREWALL_LOCKDOWN'].to_s.match?(/\A(1|true|yes)\z/i)
end

def prepend_uv_venv_to_path!
  venv_bin = File.expand_path('.venv/bin', __dir__)
  return unless File.executable?(File.join(venv_bin, 'ansible-playbook'))

  ENV['PATH'] = "#{venv_bin}#{File::PATH_SEPARATOR}#{ENV['PATH']}"
end

def local_ssh_public_key
  candidates = [
    ENV['VAGRANT_SSH_PUBKEY'],
    File.expand_path('~/.ssh/id_ed25519.pub'),
    File.expand_path('~/.ssh/id_rsa.pub'),
  ].compact
  path = candidates.find { |candidate| File.readable?(candidate) }
  raise 'No readable SSH public key (set VAGRANT_SSH_PUBKEY or install ~/.ssh/id_ed25519.pub)' unless path

  File.readlines(path).first.strip
end

def write_vagrant_ansible_inventory(machine)
  info = machine.ssh_info
  return if info.nil?

  inventory_path = File.expand_path('inventory/vagrant.yml', __dir__)
  FileUtils.mkdir_p(File.dirname(inventory_path))

  operator_key = [
    ENV['VAGRANT_SSH_KEY'],
    File.expand_path('~/.ssh/id_ed25519'),
    File.expand_path('~/.ssh/id_rsa'),
  ].compact.find { |path| File.readable?(path) }

  existing = File.readable?(inventory_path) ? File.read(inventory_path) : ''
  # After the base role, sshd AllowUsers is ops only. Keep ops once switched.
  use_ops = existing.match?(/ansible_user:\s*ops\b/) || ENV['VAGRANT_ANSIBLE_USER'].to_s == 'ops'
  if use_ops
    raise 'ops SSH key not found (set VAGRANT_SSH_KEY or install ~/.ssh/id_ed25519)' if operator_key.nil?

    user = 'ops'
    private_key = operator_key
  else
    user = info[:username]
    private_key = Array(info[:private_key_path]).first
  end

  File.write(inventory_path, <<~YAML)
    ---
    # Generated by Vagrant after `vagrant up`. Do not commit.
    # First play: vagrant + box key. After the base role: ansible_user ops.
    all:
      children:
        secure_vps:
          hosts:
            vps1:
              ansible_host: #{info[:host]}
              ansible_user: #{user}
              ansible_port: #{info[:port]}
              ansible_ssh_private_key_file: #{private_key}
              ansible_become: true
              allow_undersized_host: true
  YAML
end


# see https://docs.cloud-init.io/en/25.1/reference/network-config.html
# see https://docs.cloud-init.io/en/25.1/reference/network-config-format-v2.html
cloud_init_network_config = {
  'version' => 2,
  'ethernets' => {
    'eth0' => {
      'dhcp4' => true,
      # NB uncomment these properties to configure a static IP address.
      # 'dhcp4' => false,
      # 'addresses' => [
      #   '10.0.0.123/24',
      # ],
      # 'routes' => [
      #   {
      #     'to' => '0.0.0.0/0',
      #     'via' => '10.0.0.1',
      #   },
      # ],
      # 'nameservers' => {
      #   'addresses' => [
      #     '10.0.0.1',
      #   ],
      # },
      # NB in debian trixie (13) setting dhcp6 to false does not actually disable ipv6,
      #    it just prevents cloud-init from adding the iface eth0 inet6 dhcp line to the
      #    /etc/network/interfaces.d/50-cloud-init file. that inet6 ifupdown method no
      #    longer works in debian trixie (13) because it expects to find the dhclient
      #    binary which no longer exists by default (the isc-dhcp-client package is
      #    deprecated, and is no longer installed by default; it was replaced by the
      #    dhcpcd-base package, which provides the dhcpcd binary).
      #    see https://packages.debian.org/trixie/isc-dhcp-client
      #    see https://packages.debian.org/trixie/dhcpcd-base
      #    see https://packages.debian.org/trixie/ifupdown
      'dhcp6' => false,
    },
  },
}

# see https://docs.cloud-init.io/en/25.1/explanation/format.html
# see https://docs.cloud-init.io/en/25.1/reference/cloud-config.html
# see https://docs.cloud-init.io/en/25.1/reference/modules.html
cloud_init_user_data = {
  # modify the provisioning user credentials.
  'users' => [
    {
      'name' => $provision_username,
      'plain_text_passwd' => $provision_password,
      'lock_passwd' => false,
    },
  ],
  # NB the runcmd output is written to journald and /var/log/cloud-init-output.log.
  'runcmd' => [
    "echo '************** DONE RUNNING CLOUD-INIT **************'",
  ],
}

Vagrant.configure(2) do |config|
  config.vm.box = "cloud-image/debian-13"
  # cloud-image/debian-13 boots with the vagrant user and key auth. The ops
  # account is created later by the Ansible base role.
  config.ssh.username = 'vagrant'
  config.ssh.insert_key = true
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider :libvirt do |libvirt|
    libvirt.driver = "kvm"
    libvirt.uri = 'qemu:///system'
  end

  config.vm.provider 'libvirt' do |lv, config|
    lv.memory = $vm_memory
    lv.cpus = $vm_cpus
    lv.cpu_mode = 'host-passthrough'
    lv.nested = true # nested virtualization.
    lv.keymap = 'pt'
    lv.machine_virtual_size = $vm_disk
  end

  ssh_pub_key = local_ssh_public_key

  if vagrant_bridged?
    bridge_dev = ENV['VAGRANT_BRIDGE'].to_s
    raise 'VAGRANT_BRIDGED=1 requires VAGRANT_BRIDGE (host interface or bridge, for example br0 or enp1s0).' if bridge_dev.empty?

    config.vm.network :public_network,
      :dev => bridge_dev,
      :mode => 'bridge',
      :type => 'bridge'
  end

  config.vm.provision 'shell', inline: <<-SHELL
    install -d -m 700 -o vagrant -g vagrant /home/vagrant/.ssh
    grep -qxF '#{ssh_pub_key}' /home/vagrant/.ssh/authorized_keys || \
      echo '#{ssh_pub_key}' >> /home/vagrant/.ssh/authorized_keys
    chmod 600 /home/vagrant/.ssh/authorized_keys
    chown vagrant:vagrant /home/vagrant/.ssh/authorized_keys
  SHELL

  config.vm.provision 'shell', inline: <<-SHELL, name: 'wait for cloud-init to finish'
    cloud-init status --long --wait
    rc=$?
    if [ "$rc" -eq 1 ]; then exit 1; fi
  SHELL

  config.trigger.after :up do |trigger|
    trigger.name = 'Write inventory/vagrant.yml'
    trigger.ruby do |_env, machine|
      write_vagrant_ansible_inventory(machine)
    end
  end

  if vagrant_run_ansible?
    prepend_uv_venv_to_path!
    unless system('command -v ansible-playbook >/dev/null 2>&1')
      raise 'ansible-playbook not found. Run ./setup-controller.sh, then retry with VAGRANT_ANSIBLE=1.'
    end

    config.vm.provision 'ansible' do |ansible|
      ansible.playbook = 'site.yml'
      ansible.config_file = File.expand_path('ansible.cfg', __dir__)
      ansible.compatibility_mode = '2.0'
      ansible.become = true
      ansible.ask_vault_pass = true
      ansible.ask_become_pass = true
      ansible.groups = {
        'secure_vps' => ['default'],
      }
      ansible.extra_vars = {
        firewall_lockdown_confirm: vagrant_firewall_lockdown?,
        allow_undersized_host: true,
      }
    end
  end
end
