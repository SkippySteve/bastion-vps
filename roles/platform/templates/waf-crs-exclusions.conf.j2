# Forgejo serves repository files whose names CRS would otherwise treat as
# restricted extensions (.sh, .cfg, .conf) or restricted files (.gitignore).
# Forgejo also legitimately processes repository files, pull requests, issues,
# comments, commit messages, and markdown containing code snippets, SQL
# keywords (such as DELETE, SELECT, DROP), shell syntax, and diffs.
# Exclude user content parameters from attack inspection on git.<domain>.
# Leave smart HTTP on CRS so clone stays on SSH :2222. Nginx still denies hidden /.git paths.
SecRule REQUEST_HEADERS:Host "@streq {{ git_fqdn }}" \
 "id:10010,\
  phase:1,\
  pass,\
  nolog,\
  t:none,\
  chain"
SecRule REQUEST_URI "!@rx (?:^|/)(?:info/refs|git-upload-pack|git-receive-pack)(?:\?|$)" \
