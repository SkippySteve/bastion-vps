# Wazuh Dashboard Discover legitimately probes the signed 32-bit upper bound
# (2147483647) in this internal request. CRS 942220 classifies that value as
# an integer-overflow probe. Limit the exclusion to the security host, exact
# endpoint, exact JSON argument, and the single offending rule.
SecRule REQUEST_HEADERS:Host "@streq {{ security_fqdn }}" \
 "id:10012,\
  phase:1,\
  pass,\
  nolog,\
  t:none,\
  chain"
SecRule REQUEST_URI "@streq /internal/search/opensearch-with-long-numerals" \
 "t:none,\
  ctl:ruleRemoveTargetById=942220;ARGS:json.params.body.highlight.fragment_size"
