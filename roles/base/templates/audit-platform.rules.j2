## Managed by Ansible. Keep this bounded to security-sensitive changes.
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k privilege_policy
-w /etc/sudoers.d -p wa -k privilege_policy
-w /etc/ssh -p wa -k ssh_policy
-w /etc/pam.d -p wa -k authentication_policy
-w /etc/systemd/system -p wa -k service_policy
-w /etc/nftables.conf -p wa -k firewall_policy
-w /etc/motd -p wa -k login_banner
-w /etc/issue -p wa -k login_banner
-w /etc/issue.net -p wa -k login_banner
-w /etc/crontab -p wa -k scheduled_jobs
-w /etc/cron.d -p wa -k scheduled_jobs
-w /etc/cron.hourly -p wa -k scheduled_jobs
-w /etc/cron.daily -p wa -k scheduled_jobs
-w /etc/cron.weekly -p wa -k scheduled_jobs
-w /etc/cron.monthly -p wa -k scheduled_jobs
-w /etc/login.defs -p wa -k password_policy
-w /etc/default/useradd -p wa -k password_policy
-w /etc/security -p wa -k authentication_policy
-w /usr/bin/sudo -p x -k privileged_command
-a always,exit -F arch=b64 -S setuid,setgid,setreuid,setregid -F auid>={{ admin_uid }} -F auid!=unset -k privilege_change
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k kernel_module
